# Copy to deploy/.env on the server and fill in. Never commit the real .env.
# --- Domains (point both A records at the droplet IP first) ---
API_DOMAIN=api.example.com
SITE_DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Public operator details shown on the privacy/terms/support pages ---
OPERATOR_NAME=Zunitech
OPERATOR_COUNTRY=Pakistan
SUPPORT_EMAIL=support@example.com

# --- Server secrets (setup.sh generates DATA_ENCRYPTION_KEY if empty) ---
DATA_ENCRYPTION_KEY=
# Use a PAID Gemini API key (billing on) — the free tier may use prompts to improve Google products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WEB_ORIGIN=
FREE_AI_DAILY_LIMIT=5
PRO_AI_DAILY_LIMIT=50
BILLING_ENABLED=false
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
DEXCOM_REGION=sandbox
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_REDIRECT_URI=https://api.example.com/cgm/dexcom/callback
GOOGLE_PLACES_API_KEY=
# FatSecret Platform (Premier Free) — server-side only
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
