# Server-side secrets. Never put these in EXPO_PUBLIC variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:8081
DATABASE_PATH=server/data/accounts.sqlite
# Required in production: random persistent 32-byte key as 64 lowercase hex characters.
DATA_ENCRYPTION_KEY=
# Optional legacy development pairing only. Disabled by default; unavailable in production.
ALLOW_DEV_PAIRING=0
SNAP_API_TOKEN=
# Store billing remains disabled until approved products and offerings are ready.
BILLING_ENABLED=false
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
FREE_AI_DAILY_LIMIT=5
PRO_AI_DAILY_LIMIT=50
# Sandbox access first; commercial production requires Dexcom approval.
DEXCOM_REGION=sandbox
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_REDIRECT_URI=
