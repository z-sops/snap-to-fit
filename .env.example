# Public app configuration only (bundled into the app — never put secrets here).
# Copy to .env.production for release builds; restart Expo after changes.
EXPO_PUBLIC_API_URL=https://api.example.com
# Website root: /privacy, /terms, /support and /delete-account are linked in the app.
EXPO_PUBLIC_SITE_URL=https://example.com
# Exercise images served by our own server (deploy/setup.sh mirrors them).
EXPO_PUBLIC_EXERCISE_MEDIA_URL=https://api.example.com/media/exercises
# Public store SDK keys; never the RevenueCat secret key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Optional overrides if policies live elsewhere.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
